{
  "name": "mpietrucha/laravel-essentials",
  "description": "Laravel essentials.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Michał Pietrucha",
      "email": "michal.pietrucha@off-site.pl"
    }
  ],
  "require": {
    "php": "^8.5",
    "composer-runtime-api": "^2.2",
    "barryvdh/laravel-ide-helper": "^3.7",
    "brick/money": "^0.11.2",
    "laravel/framework": "^13.0",
    "mpietrucha/support": "^1.0",
    "nesbot/carbon": "^3.11",
    "spatie/laravel-package-tools": "^1.9",
    "spatie/laravel-translation-loader": "^2.8",
    "symfony/console": "^8.1",
    "symfony/intl": "^8.0"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.1",
    "ergebnis/composer-normalize": "^2.5",
    "filament/support": "^5.4",
    "florianv/swap": "^4.5",
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.2",
    "orchestra/testbench": "^11.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.3",
    "rector/type-perfect": "^2.1",
    "spatie/laravel-activitylog": "^4.10",
    "spatie/macroable": "^2.1",
    "symfony/var-dumper": "^8.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Mpietrucha\\Laravel\\Essentials\\": "src/",
      "Mpietrucha\\PHPStan\\": "phpstan/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "php-http/discovery": false,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mpietrucha\\Laravel\\Essentials\\LaravelEssentialsServiceProvider"
      ]
    },
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@composer normalize"
    ],
    "post-create-project-cmd": [
      "@prettier:config"
    ],
    "lint": "pint --verbose",
    "prettier:config": "curl -sSLO https://raw.githubusercontent.com/mpietrucha/prettier/refs/heads/main/dist/.prettierrc",
    "refactor": "vendor/bin/rector process --ansi",
    "refactor:dry": "@refactor --dry-run",
    "test": [
      "@test:lint",
      "@test:types"
    ],
    "test:lint": "@lint --test",
    "test:types": "phpstan analyse --ansi"
  },
  "$schema": "https://getcomposer.org/schema.json"
}
