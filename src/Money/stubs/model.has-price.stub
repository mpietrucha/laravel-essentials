    public function getReference{{ indicator }}Price(?string $priceAttribute = null, ?string $currencyAttribute = null, ?Money $discountedPrice = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();

        $discountedPrice ??= $this->getDiscounted{{ indicator }}Price(
            $priceAttribute,
            $currencyAttribute,
            $context,
            $roundingMode,
        );

        return $this->getReferencePrice($priceAttribute, $currencyAttribute, $discountedPrice, $context, $roundingMode);
