<?php

namespace {{ namespace }};

use Brick\Math\RoundingMode;
use Brick\Money\Context;
use Brick\Money\Money;
use Mpietrucha\Laravel\Essentials\Eloquent\Casts\Attribute;

trait {{ trait }}
{
    use HasPrice;

    public static function getDefault{{ indicator }}PriceAttribute(): string
    {
        return '{{ attribute }}_price';
    }

    public static function getDefaultDiscounted{{ indicator }}PriceAttribute(): string
    {
        return 'discounted_{{ attribute }}_price';
    }

    public static function getDefaultNormalized{{ indicator }}PriceAttribute(): string
    {
        return 'normalized_price';
    }

    public static function getDefault{{ indicator }}PriceCurrencyAttribute(): string
    {
        return static::getDefaultPriceCurrencyAttribute();
    }

    public static function getDefaultNormalized{{ indicator }}PriceTargetCurrency(): mixed
    {
        return static::getDefaultNormalizedPriceTargetCurrency();
    }

    public function get{{ indicator }}PriceCurrencyAttributeValue(?string $currencyAttribute = null): mixed
    {
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        return $this->getPriceCurrencyAttributeValue($currencyAttribute);
    }

    public function get{{ indicator }}Price(?string $priceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        return $this->getPrice($priceAttribute, $currencyAttribute, $context, $roundingMode);
    }

    public function getConverted{{ indicator }}Price(mixed $targetCurrency = null, ?string $priceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        return $this->getConvertedPrice($targetCurrency, $priceAttribute, $currencyAttribute, $context, $roundingMode);
    }

    public function getDiscounted{{ indicator }}Price(?string $priceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        return $this->getDiscountedPrice($priceAttribute, $currencyAttribute, $context, $roundingMode);
    }

    public function getConvertedDiscounted{{ indicator }}Price(mixed $targetCurrency = null, ?string $discountedPriceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $discountedPriceAttribute ??= static::getDefaultDiscounted{{ indicator }}PriceAttribute();

        return $this->getConvertedDiscountedPrice($targetCurrency, $discountedPriceAttribute, $currencyAttribute, $context, $roundingMode);
    }

    public function getReference{{ indicator }}Price(?string $priceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        return $this->getReferencePrice($priceAttribute, $currencyAttribute, $context, $roundingMode);
    }

    public function getNormalized{{ indicator }}Price(?string $discountedPriceAttribute = null, ?string $priceAttribute = null, ?string $currencyAttribute = null, mixed $targetCurrency = null, ?Context $context = null, ?RoundingMode $roundingMode = null): ?Money
    {
        $discountedPriceAttribute ??= static::getDefaultDiscounted{{ indicator }}PriceAttribute();

        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        $targetCurrency ??= static::getDefaultNormalized{{ indicator }}PriceTargetCurrency();

        return $this->getNormalizedPrice(discountedPriceAttribute, $priceAttribute, $currencyAttribute, $targetCurrency, $context, $roundingMode);
    }

    public function normalize{{ indicator }}Price(?string $normalizedPriceAttribute = null, ?string $discountedPriceAttribute = null, ?string $priceAttribute = null, ?string $currencyAttribute = null, mixed $targetCurrency = null, ?Context $context = null, ?RoundingMode $roundingMode = null): static
    {
        $normalizedPriceAttribute ??= static::getDefaultNormalized{{ indicator }}PriceAttribute();
        $discountedPriceAttribute ??= static::getDefaultDiscounted{{ indicator }}PriceAttribute();

        $priceAttribute ??= static::getDefault{{ indicator }}PriceAttribute();
        $currencyAttribute ??= static::getDefault{{ indicator }}PriceCurrencyAttribute();

        $targetCurrency ??= static::getDefaultNormalized{{ indicator }}PriceTargetCurrency();

        return $this->normalizePrice($normalizedPriceAttribute, $discountedPriceAttribute, $priceAttribute, $currencyAttribute, $targetCurrency, $context, $roundingMode);
    }

    /**
     * @return Attribute<null|numeric-string, never>
     */
    protected function {{ name }}Price(): Attribute
    {
        return $this->get{{ indicator }}Price(...) |> Attribute::getMoneyAmount(...);
    }

    /**
     * @return Attribute<null|numeric-string, never>
     */
    protected function converted{{ indicator }}Price(): Attribute
    {
        return $this->getConverted{{ indicator }}Price(...) |> Attribute::getMoneyAmount(...);
    }

    /**
     * @return Attribute<null|numeric-string, never>
     */
    protected function discounted{{ indicator }}Price(): Attribute
    {
        return $this->getDiscounted{{ indicator }}Price(...) |> Attribute::getMoneyAmount(...);
    }

    /**
     * @return Attribute<null|numeric-string, never>
     */
    protected function convertedDiscounted{{ indicator }}Price(): Attribute
    {
        return $this->getConvertedDiscounted{{ indicator }}Price(...) |> Attribute::getMoneyAmount(...);
    }

    /**
     * @return Attribute<null|numeric-string, never>
     */
    protected function reference{{ indicator }}Price(): Attribute
    {
        return $this->getReference{{ indicator }}Price(...) |> Attribute::getMoneyAmount(...);
    }

    /**
     * @param  Builder<static>  $builder
     */
    #[Scope]
    protected function whereNormalized{{ indicator }}Price(Builder $builder, mixed $price, string $operator = '=', mixed $sourceCurrency = null, mixed $targetCurrency = null, ?string $normalizedPriceAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): void
    {
        $targetCurrency ??= static::getDefaultNormalized{{ indicator }}PriceTargetCurrency();
        $normalizedPriceAttribute ??= static::getDefaultNormalized{{ indicator }}PriceAttribute();

        $this->whereNormalizedPrice($builder, $price, $operator, $sourceCurrency, $targetCurrency, $normalizedPriceAttribute, $context, $roundingMode);
    }

    protected static function bootHas{{ indicator }}Price(): void
    {
        static::saving(static function (self $hasPrice): void {
            $hasPrice->normalize{{ indicator }}Price();
        });
    }
}
