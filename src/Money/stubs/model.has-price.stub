     */
    protected function reference{{ indicator }}Price(?string $priceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): Attribute
    {
        return Attribute::getMoneyAmount(fn (): ?Money => $this->getReference{{ indicator }}Price(
            $priceAttribute,
            $currencyAttribute,
            null,
            $context,
            $roundingMode,
        ));
    }

    protected static function bootHasPrice(): void
    {
        static::saving(static fn (self $has{{indicator}}Price): self => $has{{indicator}}Price->normalize{{ indicator }}Price());
    }
