     */
    protected function {{ name }}Price(?string $priceAttribute = null, ?string $currencyAttribute = null, ?Context $context = null, ?RoundingMode $roundingMode = null): Attribute
    {
        return Attribute::getMoneyAmount(fn (): ?Money => $this->get{{ indicator }}Price(
