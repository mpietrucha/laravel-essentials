trait {{ trait }}
{
    use HasPrice;

    public function normalize{{ indicator }}Price(?string $normalizedPriceAttribute = null): static
    {
         $normalizedPriceAttribute ??= 'normalized_{{ attribute }}_price';

         return $this->normalizePrice($normalizedPriceAttribute);
